library(ggplot2)
library(corrplot)
library(scales)
library(scales)
library(corrplot)
library(ggplot2)
library(ggplot2)
library(corrplot)
library(scales)
options(scipen = 999)
energy <- read.csv("EuroEnergy.csv")
colnames(energy)[1] <- "Country"
head(energy)
View(energy)
str(energy)
summary(energy)
hist(
energy$gdp,
main = "Distribution of GDP",
xlab = "GDP",
col = "lightblue",
border = "black"
)
ggplot(
energy,
aes(x = gdp)
) +
geom_histogram(
bins = 10,
fill = "steelblue",
color = "black"
) +
scale_x_continuous(labels = comma) +
ext(
title = "Distribution of GDP",
x = "GDP",
y = "Frequency"
)
ggplot(euro, aes(x = gdp)) +
geom_histogram(bins = 10, fill = "steelblue", color = "black") +
scale_x_continuous(labels = comma) +
labs(
title = "Distribution of GDP",
x = "GDP",
y = "Frequency"
)
ggplot(euro, aes(x = gdp)) +
geom_histogram(bins = 10, fill = "steelblue", color = "black") +
scale_x_continuous(labels = comma) +
labs(
title = "Distribution of GDP",
x = "GDP",
y = "Frequency"
)
euro <- read.csv("EuroEnergy.csv", stringsAsFactors = FALSE)
names(euro)[1] <- "Country"
print(euro)
str(euro)
dim(euro)
summary(euro)
hist(
euro$gdp,
main = "Distribution of GDP",
xlab = "GDP",
col = "lightblue",
border = "black"
)
ggplot(data = euro, aes(x = gdp)) +
geom_histogram(bins = 10, fill = "steelblue", color = "black") +
scale_x_continuous(labels = comma) +
labs(
title = "Distribution of GDP",
x = "GDP",
y = "Frequency"
)
boxplot(euro$gdp, main = "Boxplot of GDP", col = "lightgreen")
boxplot(euro$energy, main = "Boxplot of Energy", col = "yellow")
ggplot(data = euro, aes(x = factor(1), y = gdp)) +
geom_boxplot(alpha = 0.7, outlier.color = "#E74C3C", outlier.shape = 16) +
scale_y_continuous(labels = comma) +
labs(
title = "Boxplot of GDP",
x = "",
y = "GDP"
) +
theme_minimal() +
theme(legend.position = "none")
hist(
euro$gdp,
main = "Distribution of GDP",
xlab = "GDP",
col = "lightblue",
border = "black"
)
ggplot(
euro,
aes(x = gdp)
) +
geom_histogram(
bins = 10,
fill = "steelblue",
color = "black"
) +
scale_x_continuous(labels = comma) +
labs(
title = "Distribution of GDP",
x = "GDP",
y = "Frequency"
)
boxplot(
euro$gdp,
main = "Boxplot of GDP",
col = "lightgreen"
)
boxplot(
euro$energy,
main = "Boxplot of Energy",
col = "yellow"
)
ggplot(euro, aes(x = as.factor(1), y = gdp, fill = as.factor(1))) +
geom_boxplot(alpha = 0.7, outlier.color = "#E74C3C", outlier.shape = 16) +
scale_y_continuous(labels = comma) +
labs(
title = "Boxplot of GDP",
x = "",
y = "GDP",
fill = "Legend"
) +
theme_minimal() +
theme(legend.position = "none")
ggplot(
euro,
aes(
x = gdp,
y = energy
)
) +
geom_point(
size = 3,
color = "blue"
) +
scale_x_continuous(labels = comma) +
scale_y_continuous(labels = comma) +
labs(
title = "GDP vs Energy",
x = "GDP",
y = "Energy"
)
ggplot(
euro,
aes(
x = gdp,
y = energy
)
) +
geom_point(size = 3) +
geom_smooth(
method = "lm",
se = FALSE,
color = "red"
) +
scale_x_continuous(labels = comma) +
scale_y_continuous(labels = comma) +
labs(
title = "GDP vs Energy"
)
cor(
euro$gdp,
euro$energy
)
cor(
euro$gdp,
euro$energy
)
cor(
euro$gdp,
euro$energy
)
cor_matrix <- cor(euro[, c("gdp", "energy")])
cor_matrix
corrplot(
cor_matrix,
method = "color",
type = "upper"
)
pairs(
euro[, c("gdp", "energy")],
main = "Pairwise scatterplots"
)
cor_value <- cor(euro$gdp, euro$energy)
cat("1. Correlation between GDP and Energy =", round(cor_value, 3), "\n\n")
print(euro[order(-euro$gdp), c("Country", "gdp")][1:3, ])
